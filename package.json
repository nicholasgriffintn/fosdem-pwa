{
	"name": "roomisfull",
	"version": "0.2025.1",
	"private": true,
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "pnpm --filter @roomisfull/web dev",
		"dev:fosdem": "pnpm --filter @roomisfull/web dev:fosdem",
		"build": "pnpm --filter @roomisfull/web build",
		"test": "pnpm -r --if-present test",
		"lint": "pnpm -r --if-present lint",
		"typecheck": "pnpm -r --if-present typecheck",
		"format": "pnpm --filter @roomisfull/web format"
	}
}
