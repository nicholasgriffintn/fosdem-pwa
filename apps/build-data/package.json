{
	"name": "@roomisfull/build-data",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "wrangler deploy --dry-run --outdir dist",
		"build:fosdem": "wrangler deploy --dry-run --outdir dist --env fosdem",
		"deploy": "wrangler deploy",
		"deploy:fosdem": "wrangler deploy --env fosdem",
		"dev": "wrangler dev",
		"dev:fosdem": "wrangler dev --env fosdem",
		"start": "wrangler dev",
		"start:fosdem": "wrangler dev --env fosdem",
		"cf-typegen": "wrangler types",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@cloudflare/workers-types": "5.20260926.1",
		"typescript": "7.0.2",
		"vitest": "5.0.2",
		"wrangler": "4.141.0"
	},
	"dependencies": {
		"@sentry/cloudflare": "11.0.0",
		"xml-js": "1.6.11",
		"@roomisfull/conference": "workspace:*"
	}
}
