{
	"name": "@roomisfull/push",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "wrangler deploy --dry-run --outdir dist",
		"build:fosdem": "wrangler deploy --dry-run --outdir dist --env fosdem",
		"deploy": "wrangler deploy",
		"deploy:fosdem": "wrangler deploy --env fosdem",
		"dev": "wrangler dev --test-scheduled --persist-to ../cloudflare/state",
		"dev:fosdem": "wrangler dev --env fosdem --test-scheduled --persist-to ../cloudflare/state",
		"start": "wrangler dev --test-scheduled --persist-to ../cloudflare/state",
		"start:fosdem": "wrangler dev --env fosdem --test-scheduled --persist-to ../cloudflare/state",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to ../cloudflare/state",
		"db:migrate:prod": "wrangler d1 migrations apply DB --remote"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260925.2",
		"vitest": "5.0.2",
		"typescript": "7.0.2",
		"wrangler": "4.135.0"
	},
	"dependencies": {
		"@sentry/cloudflare": "11.0.0",
		"webpush-webcrypto": "1.0.5",
		"@roomisfull/conference": "workspace:*"
	}
}
