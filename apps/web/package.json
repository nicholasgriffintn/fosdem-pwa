{
  "name": "@fosdem-pwa/web",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "dev": "vite dev --port 3000",
    "build:sw": "tsx ./scripts/generate-sw.ts",
    "build": "NODE_ENV=production vite build && pnpm build:sw",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "pnpm biome lint ./src",
    "typecheck": "tsc --noEmit",
    "format": "pnpm biome format --write ./src",
    "db": "drizzle-kit",
    "ui": "pnpm dlx shadcn@latest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fosdem --local --persist-to ../cloudflare/state",
    "db:migrate:prod": "wrangler d1 migrations apply fosdem --remote",
    "deploy": "NODE_ENV=production wrangler deploy --env production"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ngriffin_uk/auth-core": "^0.4.2",
    "@ngriffin_uk/auth-crypto": "^1.0.3",
    "@ngriffin_uk/auth-oauth2": "^3.0.3",
    "@ngriffin_uk/auth-encoding": "^0.2.4",
    "@ngriffin_uk/auth-jwt": "^1.1.3",
    "@ngriffin_uk/auth-request": "^0.2.4",
    "@ngriffin_uk/auth-provider-discord": "^3.0.2",
    "@ngriffin_uk/auth-provider-github": "^3.0.2",
    "@ngriffin_uk/auth-provider-gitlab": "^3.0.2",
    "@ngriffin_uk/auth-provider-mastodon": "^3.0.2",
    "@ngriffin_uk/auth-react": "^0.6.0",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@sentry/react": "^10.69.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.34",
    "@tanstack/react-virtual": "^3.14.9",
    "@unpic/react": "1.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fuse.js": "7.5.0",
    "hls.js": "1.6.16",
    "lucide-react": "1.28.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "vite": "8.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.6",
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "10.5.4",
    "drizzle-kit": "0.31.10",
    "glob": "13.0.6",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.116.0"
  }
}
